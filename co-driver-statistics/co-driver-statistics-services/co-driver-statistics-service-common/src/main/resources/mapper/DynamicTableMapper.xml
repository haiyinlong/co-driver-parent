<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.leo.ad.codriver.common.dao.DynamicTableRepository">

    <select id="getDbCount" resultType="com.leo.ad.codriver.common.DwCountDTO">
        SELECT count(1), min(duar.id) min_id, max(duar.id) max_id
        FROM ${tableName} duar
        WHERE duar.dates = #{dates}
        <if test="startId != null and startId > 0">
            and duar.id > #{startId}
        </if>
    </select>
</mapper>
