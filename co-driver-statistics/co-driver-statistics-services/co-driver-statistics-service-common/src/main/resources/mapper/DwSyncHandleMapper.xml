<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.leo.ad.codriver.common.dao.DwSyncHandleMapper">


    <sql id="Base_Column_List">
        id,`table_name`,handle_class,
        create_time,update_time
    </sql>
    <select id="queryByTableName" resultType="com.leo.ad.codriver.common.dao.entity.DwSyncHandle">
        select
        <include refid="Base_Column_List"/>
        from dw_sync_handle
        where table_name = #{tableName}
    </select>
</mapper>
