<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.leo.ad.codriver.clean.dao.OdsEventReportCleanDao">
    <delete id="deleteByLastMonthsAgo">
        DELETE
        FROM ods_event_report
        where dates <![CDATA[ <  ]]> DATE_FORMAT(NOW() - INTERVAL 20 DAY, '%Y%m%d')
    </delete>
</mapper>
