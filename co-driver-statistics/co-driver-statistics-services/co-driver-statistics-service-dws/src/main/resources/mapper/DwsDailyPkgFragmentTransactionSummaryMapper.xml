<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.leo.ad.codriver.dws.dao.DwsDailyPkgFragmentTransactionSummaryMapper">

    <resultMap id="BaseResultMap" type="com.leo.ad.codriver.dws.entity.DwsDailyPkgFragmentTransactionSummary">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="dates" column="dates" jdbcType="INTEGER"/>
        <result property="pkg" column="pkg" jdbcType="VARCHAR"/>
        <result property="fragment" column="fragment" jdbcType="INTEGER"/>
        <result property="fragmentUserNum" column="fragment_user_num" jdbcType="INTEGER"/>
        <result property="outputNum" column="output_num" jdbcType="INTEGER"/>
        <result property="expendNum" column="expend_num" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,dates,pkg,
        fragment,fragment_user_num,output_num,expend_num,
        create_time
    </sql>
    <delete id="deleteByDates">
        DELETE
        FROM dws_daily_pkg_fragment_transaction_summary
        WHERE dates = #{dates}
    </delete>
</mapper>
