<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.leo.ad.codriver.dws.dao.DwsDailyCohortPkgOnlineMapper">

    <resultMap id="BaseResultMap" type="com.leo.ad.codriver.dws.entity.DwsDailyCohortPkgOnline">
        <result property="id" column="id" jdbcType="BIGINT" />
        <result property="dates" column="dates" jdbcType="INTEGER" />
        <result property="pkg" column="pkg" jdbcType="VARCHAR" />
        <result property="registerDates" column="register_dates" jdbcType="INTEGER" />
        <result property="cohortDay" column="cohort_day" jdbcType="BIGINT" />
        <result property="totalOnlineTime" column="total_online_time" jdbcType="BIGINT" />
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" />
    </resultMap>

    <sql id="Base_Column_List">
        id,dates,pkg,
        register_dates,cohort_day,total_online_time,
        create_time
    </sql>
    <select id="queryDbListByDates" resultType="com.leo.ad.codriver.dws.entity.DwsDailyCohortPkgOnline">
        select
        <include refid="Base_Column_List" />
        from dws_daily_cohort_pkg_online
        where dates=#{dates}
    </select>
</mapper>
