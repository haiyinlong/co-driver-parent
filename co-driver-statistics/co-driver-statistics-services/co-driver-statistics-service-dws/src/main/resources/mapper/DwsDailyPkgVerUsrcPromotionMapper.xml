<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.leo.ad.codriver.dws.dao.DwsDailyPkgVerUsrcPromotionMapper">


    <sql id="Base_Column_List">
        id,dates,pkg,
        version,user_source,pkg_user_num,
        cost,change_cost,user_num,
        user_rate,pkg_cost,pkg_change_cost,
        cpi,create_time
    </sql>
    <select id="queryDbList" resultType="com.leo.ad.codriver.dws.entity.DwsDailyPkgVerUsrcPromotion">
        select
        <include refid="Base_Column_List"/>
        from dws_daily_pkg_ver_usrc_promotion
        where dates = #{dates}
    </select>
</mapper>
