<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.leo.ad.codriver.dws.dao.DwsDailyCohortPkgUsrcConversionMapper">

    <resultMap id="BaseResultMap" type="com.leo.ad.codriver.dws.entity.DwsDailyCohortPkgUsrcConversion">
        <result property="id" column="id" jdbcType="BIGINT" />
        <result property="dates" column="dates" jdbcType="INTEGER" />
        <result property="registerDates" column="register_dates" jdbcType="INTEGER" />
        <result property="cohortDay" column="cohort_day" jdbcType="BIGINT" />
        <result property="pkg" column="pkg" jdbcType="VARCHAR" />
        <result property="userSource" column="user_source" jdbcType="VARCHAR" />
        <result property="riverUserNum" column="river_user_num" jdbcType="INTEGER" />
        <result property="mysteryBoxUserNum" column="mystery_box_user_num" jdbcType="INTEGER" />
        <result property="totalUserNum" column="total_user_num" jdbcType="BIGINT" />
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" />
    </resultMap>

    <sql id="Base_Column_List">
        id,dates,register_dates,
        cohort_day,pkg,user_source,
        river_user_num,mystery_box_user_num,total_user_num,
        create_time
    </sql>
    <select id="queryDbListByDates"
            resultType="com.leo.ad.codriver.dws.entity.DwsDailyCohortPkgUsrcConversion">
        select
        <include refid="Base_Column_List" />
        from dws_daily_cohort_pkg_usrc_conversion
        where dates=#{dates}
    </select>
</mapper>
